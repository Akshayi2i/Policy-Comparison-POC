# Qwen3-VL-Instruct served by vLLM on a RunPod pod (OpenAI-compatible proxy URL).
# Leave LLM_BASE_URL empty to run with the deterministic narrative only.
LLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
LLM_API_KEY=<the --api-key you started vLLM with, or EMPTY>
LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
LLM_MAX_CONTEXT=32768
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_TIMEOUT_S=180
LLM_RETRIES=3
LLM_STREAM=true
# json_schema (vLLM response_format) | guided_json (older vLLM) | none (prompt + validate)
LLM_STRUCTURED=json_schema

# Folder for reports (PDF + report JSON). Default: <project>/output
# OUTPUT_DIR=D:\POC4\output
